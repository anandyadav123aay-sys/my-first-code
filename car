<!DOCTYPE html>
<html>
<head>
    <title>Click the Box Game</title>
    <style>
        body {
            font-family: Arial;
            text-align: center;
        }
        #gameArea {
            width: 600px;
            height: 400px;
            border: 4px solid black;
            margin: auto;
            position: relative;
            background: #f0f0f0;
        }
        #box {
            width: 60px;
            height: 60px;
            background: red;
            position: absolute;
            cursor: pointer;
        }
    </style>
</head>
<body>

<h2>Click the Box Game</h2>
<p>Score: <span id="score">0</span></p>

<div id="gameArea">
    <div id="box"></div>
</div>

<script>
    let box = document.getElementById("box");
    let scoreDisplay = document.getElementById("score");
    let gameArea = document.getElementById("gameArea");
    let score = 0;

    function moveBox() {
        let maxX = gameArea.clientWidth - box.clientWidth;
        let maxY = gameArea.clientHeight - box.clientHeight;

        let x = Math.random() * maxX;
        let y = Math.random() * maxY;

        box.style.left = x + "px";
        box.style.top = y + "px";
    }

    box.onclick = function () {
        score++;
        scoreDisplay.textContent = score;
        moveBox();
    };

    setInterval(moveBox, 1100); // Box moves every 1 second
</script>

</body>
</html>
