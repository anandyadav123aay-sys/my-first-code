* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #080c14;
    color: white;
    line-height: 1.6;
}


/* Navbar */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(8, 12, 20, 0.95);
    border-bottom: 1px solid #202735;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 18px 25px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

.logo span {
    color: #00ff88;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #00ff88;
}

.nav-button {
    text-decoration: none;
    color: #07100b;
    background: #00ff88;
    padding: 10px 18px;
    border-radius: 6px;
    font-weight: bold;
}


/* Hero */

.hero {
    min-height: 650px;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;
    padding: 80px 20px;

    background:
        radial-gradient(circle at center, #10251c, #080c14 60%);
}

.hero-content {
    max-width: 850px;
}

.small-title,
.section-small {
    color: #00ff88;
    font-weight: bold;
    letter-spacing: 2px;
    font-size: 14px;
}

.hero h1 {
    font-size: 58px;
    line-height: 1.1;
    margin: 20px 0;
}

.hero h1 span,
h2 span {
    color: #00ff88;
}

.hero-text {
    color: #b8bec8;
    font-size: 18px;
    max-width: 650px;
    margin: auto;
}

.hero-buttons {
    margin-top: 35px;
}

.btn {
    display: inline-block;
    text-decoration: none;
    padding: 13px 25px;
    margin: 5px;
    border-radius: 6px;
    font-weight: bold;
}

.primary-btn {
    background: #00ff88;
    color: #07100b;
}

.secondary-btn {
    border: 1px solid #00ff88;
    color: #00ff88;
}


/* Common Sections */

section {
    padding: 90px 20px;
}

section h2 {
    font-size: 42px;
    margin: 10px 0;
}

.section-description {
    color: #9da4af;
}


/* Services */

.services {
    text-align: center;
    background: #0c111b;
}

.service-container {
    max-width: 1200px;
    margin: 50px auto 0;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.service-card {
    text-align: left;
    background: #121925;
    border: 1px solid #222c3c;
    padding: 30px;
    border-radius: 12px;

    transition: 0.3s;
}

.service-card:hover {
    transform: translateY(-8px);
    border-color: #00ff88;
}

.icon {
    font-size: 40px;
    margin-bottom: 15px;
}

.service-card h3 {
    font-size: 22px;
    margin-bottom: 10px;
}

.service-card p {
    color: #aeb5c0;
    margin-bottom: 20px;
}

.service-card a {
    color: #00ff88;
    text-decoration: none;
    font-weight: bold;
}


/* About */

.about {
    text-align: center;
}

.about-content {
    max-width: 800px;
    margin: auto;
}

.about p {
    color: #aeb5c0;
    margin: 15px 0;
}


/* Pricing */

.pricing {
    text-align: center;
    background: #0c111b;
}

.pricing-container {
    max-width: 1100px;
    margin: 50px auto 0;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.price-card {
    background: #121925;
    border: 1px solid #273143;
    padding: 35px;
    border-radius: 12px;
}

.price-card h3 {
    font-size: 24px;
}

.price-card h4 {
    font-size: 38px;
    color: #00ff88;
    margin: 15px;
}

.price-card p {
    color: #aeb5c0;
    margin: 8px;
}

.price-card a {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    background: #00ff88;
    color: #07100b;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

.featured {
    border: 2px solid #00ff88;
}


/* Contact */

.contact {
    text-align: center;
}

.contact form {
    max-width: 600px;
    margin: 35px auto 0;

    display: flex;
    flex-direction: column;
    gap: 15px;
}

.contact input,
.contact textarea {
    width: 100%;
    padding: 15px;

    background: #121925;
    color: white;

    border: 1px solid #293448;
    border-radius: 6px;

    font-size: 16px;
}

.contact textarea {
    height: 150px;
    resize: vertical;
}

.contact button {
    padding: 14px;
    border: none;
    border-radius: 6px;

    background: #00ff88;
    color: #07100b;

    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}


/* Footer */

footer {
    text-align: center;
    background: #05080e;
    padding: 40px 20px;
}

footer h3 {
    color: #00ff88;
    font-size: 24px;
}

footer p {
    color: #89919e;
    margin-top: 8px;
}

.copyright {
    margin-top: 20px;
}


/* Mobile Responsive */

@media (max-width: 800px) {

    .nav-links {
        display: none;
    }

    .hero h1 {
        font-size: 40px;
    }

    section h2 {
        font-size: 32px;
    }

    .service-container,
    .pricing-container {
        grid-template-columns: 1fr;
    }

    .nav-button {
        padding: 8px 12px;
        font-size: 14px;
    }
}

const contactForm = document.getElementById("contactForm");

contactForm.addEventListener("submit", function(event) {

    event.preventDefault();

    const name = document.getElementById("name").value;
    const email = document.getElementById("email").value;
    const service = document.getElementById("service").value;
    const message = document.getElementById("message").value;

    const phoneNumber = "7021308824";

    const whatsappMessage =
        "Hello Anand Web Services!%0A%0A" +
        "Name: " + name + "%0A" +
        "Email: " + email + "%0A" +
        "Service: " + service + "%0A" +
        "Message: " + message;

    const whatsappURL =
        "https://wa.me/" + 7021308824 +
        "?text=" + whatsappMessage;

    window.open(whatsappURL, "_blank");

    contactForm.reset();
});

/* Portfolio */

.portfolio {
