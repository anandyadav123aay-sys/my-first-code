      <h2>Services</h2>
      <ul class="services-list">
        <li>Website Development (HTML/CSS/JS)</li>
        <li>Responsive Design & Mobile Optimization</li>
        <li>Web Apps (React / Node.js)</li>
        <li>Website Maintenance & Hosting</li>
      </ul>
    </div>
  </section>

  <section id="portfolio" class="section light">
